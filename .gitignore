# ==============================
# Terraform
# ==============================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.tfplan.json

# Terraform variable files
*.tfvars
*.tfvars.json

# Exception: keep example variable files
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# ==============================
# Secrets / Environment Variables
# ==============================

.env
.env.*
!.env.example

# ==============================
# IDE / Editor
# ==============================

.vscode/
.idea/

# VS Code Terraform extension
*.tfstate.backup

# ==============================
# OS Files
# ==============================

.DS_Store
Thumbs.db

